# Configuration for llama.cpp server

# Write arguments on each line, separated by "\"

GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
CUDA_VISIBLE_DEVICES=2
LLAMA_SERVER_DELAY=0

LLAMA_SERVER_ARGS="-m /etc/models/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf \
  -ngl 999 \
  -sm layer \
  -ts 1,1 \
  -fa on \
  --no-warmup \
  --host 0.0.0.0 \
  --port 8113 \
  -ctk q8_0 \
  -ctv q8_0 \
  -kvu \
  --context-shift \
  --ctx-size 256000 \
  --cont-batching \
  --threads 2 \
  --threads-batch 2 \
  --parallel 2 \
  -b 1024 \
  -ub 256 \
  --spec-type draft-mtp,ngram-mod,ngram-simple \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --spec-draft-n-max 4 \
  --spec-ngram-mod-n-match 16 \
  --spec-ngram-mod-n-min 24 \
  --spec-ngram-mod-n-max 48 \
  -md /etc/models/mtp-gemma-4-12B-it-Q4_0.gguf \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.00 \
  --reasoning on \
  --jinja \
  --cache-ram 8192 \
  --cache-prompt \
  --cache-idle-slots
"
