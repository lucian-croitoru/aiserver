# Configuration for llama.cpp server

# Write arguments on each line, separated by "\"

GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
CUDA_VISIBLE_DEVICES=0,1
LLAMA_SERVER_DELAY=0

LLAMA_SERVER_ARGS="-m /etc/models/Swift-1.5-Qwen3.8-27B-Q8_0.gguf \
  --mmproj /etc/models/mmproj-Swift-1.5-Qwen3.8-27B-F16.gguf \
  -ngl 999 \
  -sm layer \
  -ts 1,1 \
  -fa on \
  --no-warmup \
  --host 0.0.0.0 \
  --port 8111 \
  -ctk q8_0 \
  -ctv q8_0 \
  -kvu \
  --ctx-size 320000 \
  --rope-scaling yarn \
  --yarn-orig-ctx 320000 \
  --rope-scale 2 \
  --cont-batching \
  --context-shift \
  --threads 2 \
  --threads-batch 2 \
  -b 1024 \
  -ub 256 \
  --temp 0.7 \
  --top-p 0.95 \
  --top-k 20 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --spec-type draft-mtp,ngram-mod,ngram-simple \
  --spec-draft-n-max 4 \
  --spec-ngram-mod-n-match 16 \
  --spec-ngram-mod-n-min 24 \
  --spec-ngram-mod-n-max 48 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --chat-template-kwargs \"{\\\"reasoning_effort\\\":\\\"xhigh\\\"}\"" \
  --jinja \
  --cache-ram 32768 \
  --cache-prompt \
  --cache-idle-slots
  "
