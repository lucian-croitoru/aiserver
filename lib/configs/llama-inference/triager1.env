# Configuration for llama.cpp server

# Write arguments on each line, separated by "\"

#DGGML_CUDA_FORCE_MMQ=1
#DGGML_CUDA_FORCE_CUBLAS=1
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
CUDA_VISIBLE_DEVICES=2
LLAMA_SERVER_DELAY=60

LLAMA_SERVER_ARGS="-m /etc/models/Qwen3.5-4B-UD-Q6_K_XL.gguf \
  --mmproj /etc/models/Qwen3.5-4B-mmproj-F16.gguf \
  -ngl 999 \
  -sm layer \
  -ts 1,1 \
  -fa on \
  --no-mmap \
  --host 0.0.0.0 \
  --port 8113 \
  -ctk q8_0 \
  -ctv q8_0 \
  -kvu \
  --ctx-size 240000 \
  --cont-batching \
  --context-shift \
  --threads 2 \
  --threads-batch 2 \
  --parallel 1 \
  -b 1024 \
  -ub 256 \
  --spec-type draft-mtp \
  --spec-draft-n-max 2 \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.00 \
  --reasoning on \
  --reasoning-budget 8192
  "
