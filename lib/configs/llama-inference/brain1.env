# Configuration for llama.cpp server

# Write arguments on each line, separated by "\"

#DGGML_CUDA_FORCE_MMQ=1
#DGGML_CUDA_FORCE_CUBLAS=1
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
CUDA_VISIBLE_DEVICES=0
LLAMA_SERVER_DELAY=10

LLAMA_SERVER_ARGS="-m /etc/models/Qwen3.8-27B-UD-Q4_K_XL.gguf \
  --mmproj /etc/models/Qwen3.8-27B-mmproj-F16.gguf \
  -ngl 999 \
  -sm layer \
  -ts 1,1 \
  -fa on \
  --no-mmap \
  --host 0.0.0.0 \
  --port 8112 \
  -ctk q8_0 \
  -ctv q8_0 \
  -kvu \
  --ctx-size 240000 \
  --cont-batching \
  --context-shift \
  --threads 2 \
  --threads-batch 2 \
  --parallel 2 \
  -b 1024 \
  -ub 256 \
  --temp 0.7 \
  --top-p 0.95 \
  --top-k 20 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --spec-type draft-mtp,ngram-mod \
  --spec-draft-n-max 8 \
  --spec-ngram-mod-n-match 24 \
  --spec-ngram-mod-n-min 32 \
  --spec-ngram-mod-n-max 64 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --chat-template-kwargs \"{\\\"reasoning_effort\\\":\\\"xhigh\\\"}\""
  "
