# Configuration for llama.cpp server
# Write arguments on each line, separated by "\"

# DGGML_CUDA_FORCE_MMQ=1
# DGGML_CUDA_FORCE_CUBLAS=1
# GGML_CUDA_ENABLE_UNIFIED_MEMORY=1
CUDA_VISIBLE_DEVICES=2

LLAMA_SERVER_ARGS="-m /etc/models/Qwen3.5-4B-UD-Q5_K_XL.gguf \
  --mmproj /etc/models/Qwen3.5-4B-mmproj-F16.gguf \
  -ngl 999 \
  -sm layer \
  -fa on \
  --no-mmap \
  --host 0.0.0.0 \
  --port 8114 \
  -ctk q8_0 \
  -ctv q8_0 \
  --ctx-size 96000 \
  --cont-batching \
  --threads 2 \
  --threads-batch 2 \
  --parallel 2 \
  -b 1024 \
  -ub 256 \
  --temp 0.0 \
  --top-p 1.0 \
  --top-k 1 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --reasoning off
  "
