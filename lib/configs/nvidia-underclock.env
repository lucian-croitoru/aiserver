###################################################
#         NVIDIA GPU Settings Configuration       #   
#         Settings will apply per GPU type        #
#                                                 #
#   Leave values blank to not apply any settings  #
###################################################

#########################################################################
# Set the power limit in watts for each GPU type.                       #
# Check your GPU specifications to set a limit below the maximum limit. #
# Example: NVIDIA_POWER_LIMIT_RTX3090=250                               #
#          NVIDIA_POWER_LIMIT_RTX2080TI=200                             #
#########################################################################

NVIDIA_POWER_LIMIT_RTX3090=
NVIDIA_POWER_LIMIT_RTX2080TI=
NVIDIA_POWER_LIMIT_QUADRORTX5000=

############################################################################## 
# Set the GPU memory and GPU core clocks (min/max values) for each GPU type. #
# Run `nvidia-smi -q -d SUPPORTED_CLOCKS` to see the possible (accepted)     #
# values and combinations for GPU memory and core clocks.                    #
# Example: NVIDIA_MEMORY_CLOCKS_RTX3090=405,9501                             #
#          NVIDIA_GRAPHICS_CLOCKS_RTX3090=210,1800                           #
#          NVIDIA_MEMORY_CLOCKS_RTX2080TI=405,7000                           #
#          NVIDIA_GRAPHICS_CLOCKS_RTX2080TI=210,1800                         #           
#          NVIDIA_MEMORY_CLOCKS_QUADRORTX5000=405,6501                       # 
#          NVIDIA_GRAPHICS_CLOCKS_QUADRORTX5000=300,1920                     #
#                                                                            #
##############################################################################

NVIDIA_MEMORY_CLOCKS_RTX3090=
NVIDIA_GRAPHICS_CLOCKS_RTX3090=
NVIDIA_MEMORY_CLOCKS_RTX2080TI=
NVIDIA_GRAPHICS_CLOCKS_RTX2080TI=
NVIDIA_MEMORY_CLOCKS_QUADRORTX5000=
NVIDIA_GRAPHICS_CLOCKS_QUADRORTX5000=


###########################################################################
# Set the power and clock limits for any additional GPU types.            #
# You can add more GPU types by adding new variables with the format:     #
# NVIDIA_POWER_LIMIT_<GPU_TYPE>=                                          #
# NVIDIA_MEMORY_CLOCKS_<GPU_TYPE>=                                        #
# NVIDIA_GRAPHICS_CLOCKS_<GPU_TYPE>=                                      #
###########################################################################
