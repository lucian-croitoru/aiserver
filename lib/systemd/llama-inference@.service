# Generic llama.cpp inference server (template unit).
#
# One instance per config file in /etc/llama-inference/<name>.env
# Instances are auto-enabled by llama-inference-generator on every
# `systemctl daemon-reload`, so there is nothing to enable manually.
#
# Manage a single instance:
#   systemctl start   llama-inference@planner1.service
#   systemctl restart llama-inference@worker1.service
#   systemctl stop    llama-inference@worker2.service
# Manage all instances:
#   systemctl restart 'llama-inference@*.service'
#
# After placing this file, run:
#  - `sudo systemctl daemon-reload`

[Unit]
Description=llama.cpp inference server (%i)
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=/etc/llama-inference/%i.env
ExecStartPre=/usr/bin/sleep ${LLAMA_SERVER_DELAY}
ExecStart=/usr/local/bin/llama-server.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
