# Place this file in /etc/systemd/system
# After placing it, run:
#  - `sudo systemctl daemon-reload`
#  - `sudo systemctl enable llama-brain.service`

[Unit]
Description=llama.cpp server
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=/etc/llama-brain.env
ExecStart=/usr/local/bin/llama-server.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
