# Place this file in /etc/systemd/system
# After placing it, run:
#  - `sudo systemctl daemon-reload`
#  - `sudo systemctl enable nvidia-underclock.service`

[Unit]
Description=NVIDIA Settings Configuration
After=multi-user.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nvidia-underclock.env
ExecStart=/usr/local/bin/nvidia-underclock.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
