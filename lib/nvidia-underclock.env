###################################################
#         NVIDIA GPU Settings Configuration       #   
#         Settings will apply too ALL GPUs        #
#                                                 #
#   Leave values blank to not apply any settings  #
###################################################

#########################################################################
# Set the power limit in watts.                                         #
# Check your GPU specifications to set a limit below the maximum limit. #
# Example: NVIDIA_POWER_LIMIT=250                                       #
#########################################################################

NVIDIA_POWER_LIMIT=

########################################################################## 
# Set the GPU memory and GPU core clocks (min/max values).               #
# Run `nvidia-smi -q -d SUPPORTED_CLOCKS` to see the possible (accepted) #
# values and combinations for GPU memory and core clocks.                #
# Example: NVIDIA_MEMORY_CLOCKS=405,9501                                 #
#          NVIDIA_GRAPHICS_CLOCKS=210,1800                               #
##########################################################################

NVIDIA_MEMORY_CLOCKS=
NVIDIA_GRAPHICS_CLOCKS=
